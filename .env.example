# PostgreSQL connection string
DATABASE_URL=postgresql://pricetracker:password@localhost:5432/pricetracker

# Redis connection string (crawler state, pacing, registration toggle)
REDIS_URL=redis://localhost:6379

# NextAuth.js secret (min 32 characters)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# NextAuth.js base URL (must match your deployment URL)
NEXTAUTH_URL=http://localhost:3000

# AES-256-GCM encryption key for BrickLink API secrets (64 hex chars = 32 bytes)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key-here-generate-with-openssl-rand-hex-32
