# --------------------------------------------------------------------------
# Required for both docker-compose and bare-metal setups.
# For docker-compose, only the SECRETS below are read from this file —
# DATABASE_URL / REDIS_URL / NEXTAUTH_URL are assembled by compose itself.
# For bare-metal, uncomment and adjust the connection strings at the bottom.
# --------------------------------------------------------------------------

# Postgres password (used both for the DB container and the app connection).
DB_PASSWORD=change-me-strong-password

# NextAuth.js session secret (min 32 chars). Generate:
#   openssl rand -base64 32
NEXTAUTH_SECRET=change-me-run-openssl-rand-base64-32

# NextAuth.js base URL — must match how users reach the app.
# For docker-compose local: http://localhost:3000
# For production behind a reverse proxy: https://tracker.example.com
NEXTAUTH_URL=http://localhost:3000

# AES-256-GCM key for encrypting stored BrickLink OAuth secrets.
# 64 hex chars = 32 bytes. Generate:
#   openssl rand -hex 32
# WARNING: rotating this key makes previously stored BL credentials
# unreadable — users must re-enter them under /settings.
ENCRYPTION_KEY=change-me-run-openssl-rand-hex-32

# Optional: expose the web UI on a different host port (default 3000)
# WEB_PORT=3000

# --------------------------------------------------------------------------
# Bare-metal only (bypassed by docker-compose):
# --------------------------------------------------------------------------
# DATABASE_URL=postgresql://pricetracker:CHANGE_ME@localhost:5432/pricetracker
# REDIS_URL=redis://localhost:6379
