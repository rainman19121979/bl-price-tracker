generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int             @id @default(autoincrement())
  email             String          @unique @db.VarChar(255)
  username          String          @unique @db.VarChar(100)
  passwordHash      String          @map("password_hash") @db.VarChar(255)
  isActive          Boolean         @default(true) @map("is_active")
  isAdmin           Boolean         @default(false) @map("is_admin")
  createdAt         DateTime        @default(now()) @map("created_at")
  lastLogin         DateTime?       @map("last_login")
  autoSyncInventory Boolean         @default(true) @map("auto_sync_inventory")
  crawlerEnabled    Boolean         @default(true) @map("crawler_enabled")
  freshDays         Int             @default(180) @map("fresh_days")
  pricingFormulas   String?         @map("pricing_formulas")
  shippingCountries String?         @map("shipping_countries")
  sellerCountries   String?         @map("seller_countries")
  bsxOrdersDir      String?         @map("bsx_orders_dir")
  bsxSourceType     String          @default("local") @map("bsx_source_type")
  bsxSmbHost        String?         @map("bsx_smb_host")
  bsxSmbShare       String?         @map("bsx_smb_share")
  bsxSmbSubpath     String?         @map("bsx_smb_subpath")
  bsxSmbDomain      String?         @map("bsx_smb_domain")
  bsxSmbUser        String?         @map("bsx_smb_user")
  bsxSmbPasswordEnc Bytes?          @map("bsx_smb_password_enc")
  crawlQueue        CrawlQueue[]
  apiKeys           UserApiKey[]
  watchlists        UserWatchlist[]
  mySales           MySale[]
  externalTokens    ExternalToken[]

  @@map("users")
}

model ExternalToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  token      String    @unique @db.VarChar(64)
  name       String    @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("external_tokens")
}

model UserApiKey {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  platform          String    @default("bricklink") @db.VarChar(20)
  consumerKey       String    @map("consumer_key") @db.VarChar(255)
  consumerSecretEnc Bytes     @map("consumer_secret_enc")
  tokenValue        String    @map("token_value") @db.VarChar(255)
  tokenSecretEnc    Bytes     @map("token_secret_enc")
  dailyLimit        Int       @default(1000) @map("daily_limit")
  externalCalls     String?   @map("external_calls")
  isValid           Boolean   @default(true) @map("is_valid")
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  callLog           ApiCallLog[]

  @@map("user_api_keys")
}

model ApiCallLog {
  id        BigInt     @id @default(autoincrement())
  apiKeyId  Int        @map("api_key_id")
  createdAt DateTime   @default(now()) @map("created_at")
  apiKey    UserApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt(sort: Desc)], map: "idx_api_call_log_key_time")
  @@index([createdAt], map: "idx_api_call_log_time")
  @@map("api_call_log")
}

model Part {
  id              Int             @id @default(autoincrement())
  partNo          String          @map("part_no") @db.VarChar(50)
  colorId         Int             @map("color_id")
  itemType        String          @default("PART") @map("item_type") @db.VarChar(10)
  partName        String?         @map("part_name") @db.VarChar(500)
  colorName       String?         @map("color_name") @db.VarChar(100)
  categoryId      Int?            @map("category_id")
  categoryName    String?         @map("category_name") @db.VarChar(200)
  imageUrl        String?         @map("image_url") @db.VarChar(500)
  lastPriceUpdate DateTime?       @map("last_price_update")
  lastStockUpdate DateTime?       @map("last_stock_update")
  lastSoldCrawlN  DateTime?       @map("last_sold_crawl_n")
  lastSoldCrawlU  DateTime?       @map("last_sold_crawl_u")
  lastStockCrawlN DateTime?       @map("last_stock_crawl_n")
  lastStockCrawlU DateTime?       @map("last_stock_crawl_u")
  createdAt       DateTime        @default(now()) @map("created_at")
  crawlQueue      CrawlQueue[]
  priceDaily      PriceDaily[]
  priceSales      PriceSale[]
  priceStock      PriceStock[]
  watchlists      UserWatchlist[]
  mySales         MySale[]

  @@unique([partNo, colorId, itemType])
  @@index([partNo], map: "idx_parts_part_no")
  @@index([lastPriceUpdate], map: "idx_parts_last_update")
  @@index([lastStockUpdate], map: "idx_parts_last_stock")
  @@map("parts")
}

model PriceDaily {
  id            BigInt   @id @default(autoincrement())
  partId        Int      @map("part_id")
  fetchDate     DateTime @map("fetch_date") @db.Date
  newOrUsed     String   @default("U") @map("new_or_used") @db.Char(1)
  sellerCountry String   @default("DE") @map("seller_country") @db.VarChar(2)
  currencyCode  String   @default("EUR") @map("currency_code") @db.VarChar(3)
  minPrice      Decimal? @map("min_price") @db.Decimal(10, 4)
  maxPrice      Decimal? @map("max_price") @db.Decimal(10, 4)
  avgPrice      Decimal? @map("avg_price") @db.Decimal(10, 4)
  qtyAvgPrice   Decimal? @map("qty_avg_price") @db.Decimal(10, 4)
  unitQuantity  Int?     @map("unit_quantity")
  totalQuantity Int?     @map("total_quantity")
  createdAt     DateTime @default(now()) @map("created_at")
  part          Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, fetchDate, newOrUsed, sellerCountry])
  @@index([partId, fetchDate(sort: Desc)], map: "idx_daily_part_date")
  @@index([fetchDate], map: "idx_daily_date")
  @@index([partId, newOrUsed, fetchDate(sort: Desc)], map: "idx_daily_part_used_date")
  @@map("price_daily")
}

/// This table is partitioned by RANGE on date_ordered in PostgreSQL.
/// Prisma does not natively support table partitioning. You must create
/// the partitions via a raw SQL migration, for example:
///
/// CREATE TABLE price_sales_2026_03 PARTITION OF price_sales
/// FOR VALUES FROM ('2026-03-01') TO ('2026-04-01');
///
/// Deduplication unique index (aus migration 20260815120000):
/// CREATE UNIQUE INDEX idx_sales_dedup ON price_sales
///   (part_id, date_ordered, unit_price, quantity, buyer_country,
///    new_or_used, seller_country, completeness)
///   NULLS NOT DISTINCT;
model PriceSale {
  id            BigInt   @default(autoincrement())
  partId        Int      @map("part_id")
  dateOrdered   DateTime @map("date_ordered")
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 4)
  quantity      Int
  sellerCountry String   @default("DE") @map("seller_country") @db.VarChar(2)
  buyerCountry  String?  @map("buyer_country") @db.VarChar(2)
  newOrUsed     String   @default("U") @map("new_or_used") @db.Char(1)
  completeness  String?  @map("completeness") @db.Char(1)  // SETs: 'C'=complete 'I'=incomplete 'S'=sealed; NULL bei PART/MINIFIG
  fetchedAt     DateTime @map("fetched_at") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  part          Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([id, dateOrdered])
  @@index([partId, dateOrdered(sort: Desc)], map: "idx_sales_part_date")
  @@index([buyerCountry, dateOrdered(sort: Desc)], map: "idx_sales_buyer")
  @@index([partId, newOrUsed, dateOrdered(sort: Desc)], map: "idx_sales_part_new_date")
  @@index([partId, newOrUsed, completeness, dateOrdered(sort: Desc)], map: "idx_sales_part_new_comp_date")
  @@map("price_sales")
}

/// Aktuelle Angebote (guide_type=stock) — Snapshot bei jedem Crawl
model PriceStock {
  id            BigInt   @default(autoincrement())
  partId        Int      @map("part_id")
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 4)
  quantity      Int
  sellerCountry String   @default("DE") @map("seller_country") @db.VarChar(2)
  newOrUsed     String   @default("U") @map("new_or_used") @db.Char(1)
  completeness  String?  @map("completeness") @db.Char(1)  // wie bei price_sales
  fetchedAt     DateTime @map("fetched_at") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  part          Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([id, fetchedAt])
  @@index([partId, fetchedAt(sort: Desc)], map: "idx_stock_part_date")
  @@index([partId, newOrUsed, fetchedAt(sort: Desc)], map: "idx_stock_part_new_date")
  @@index([partId, newOrUsed, completeness, fetchedAt(sort: Desc)], map: "idx_stock_part_new_comp_date")
  @@map("price_stock")
}

model UserWatchlist {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  partId        Int      @map("part_id")
  newOrUsed     String   @default("U") @map("new_or_used") @db.Char(1)
  completeness  String?  @map("completeness") @db.Char(1)  // nur bei SET-Lots gesetzt
  blInventoryId Int?     @map("bl_inventory_id")
  priority      Int      @default(5)
  myPrice       Decimal? @map("my_price") @db.Decimal(10, 4)
  myQuantity    Int?     @map("my_quantity")
  description   String?
  alertBelow    Decimal? @map("alert_below") @db.Decimal(10, 4)
  alertAbove    Decimal? @map("alert_above") @db.Decimal(10, 4)
  notes         String?
  saleRate      Int      @default(0) @map("sale_rate")
  priceLocked   Boolean  @default(false) @map("price_locked")
  myCost        Decimal? @map("my_cost") @db.Decimal(10, 4)
  remarks       String?
  prevQuantity  Int?     @map("prev_quantity")
  changedAt     DateTime? @map("changed_at")
  suggestedPrice    Decimal?  @map("suggested_price") @db.Decimal(10, 4)
  suggestedRuleName String?   @map("suggested_rule_name") @db.VarChar(100)
  marketStockMedian Decimal?  @map("market_stock_median") @db.Decimal(10, 4)
  marketSoldMedian  Decimal?  @map("market_sold_median") @db.Decimal(10, 4)
  trend             String?   @db.VarChar(10)
  pricingComputedAt DateTime? @map("pricing_computed_at")
  bulk              Int?      @default(1)
  blDateAdded       DateTime? @map("bl_date_added")
  createdAt     DateTime @default(now()) @map("created_at")
  part          Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blInventoryId])
  @@index([userId, partId, newOrUsed])
  @@index([changedAt], map: "idx_watchlist_changed")
  @@map("user_watchlists")
}

model MySale {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  partId      Int      @map("part_id")
  newOrUsed   String   @default("U") @map("new_or_used") @db.Char(1)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 4)
  soldAt      DateTime @default(now()) @map("sold_at")
  platform    String?  @db.VarChar(20)
  orderId     String?  @map("order_id") @db.VarChar(50)
  customer    String?  @db.VarChar(150)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  part        Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([userId, partId, soldAt(sort: Desc)], map: "idx_my_sales_user_part")
  @@index([userId, platform, orderId], map: "idx_my_sales_order")
  @@map("my_sales")
}

model CrawlQueue {
  id           Int       @id @default(autoincrement())
  partId       Int       @map("part_id")
  userId       Int?      @map("user_id")
  newOrUsed    String    @default("U") @map("new_or_used") @db.Char(1)
  priority     Int       @default(5)
  status       String    @default("pending") @db.VarChar(20)
  scheduledAt  DateTime  @default(now()) @map("scheduled_at")
  processedAt  DateTime? @map("processed_at")
  errorMessage String?   @map("error_message")
  retryCount   Int       @default(0) @map("retry_count")
  part         Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id])

  @@index([status, priority, scheduledAt], map: "idx_crawl_status")
  @@map("crawl_queue")
}
